# ==========================================================================
# CHIMP Arena - environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never committed.
# ==========================================================================

# --- Supabase -----------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth / token signing --------------------------------------------
# Long random string. Signs the session cookie and mission "start" tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Rewards cron ---------------------------------------------------
# Shared secret for POST /api/rewards/freeze (the weekly allocation job).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=replace-with-a-random-secret

# --- Solana -----------------------------------------------------------
# "devnet" while building, "mainnet-beta" for launch.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional custom RPC URL. Leave blank to use the public cluster endpoint.
NEXT_PUBLIC_SOLANA_RPC=

# --- Branding -------------------------------------------------------
NEXT_PUBLIC_TOKEN_SYMBOL=CHIMP
NEXT_PUBLIC_APP_NAME=CHIMP Arena

# --- $CHIMP mint ----------------------------------------------------
# The token address the app reads balances from and prices items in.
#   MAINNET (real, live):  21ZDgkJ9ULqLoGyHMskAfwVwrx6oixWzxxENu59HHoBV
#     1B fixed supply, 9 decimals, mint + freeze authority already revoked.
#   DEVNET (test stand-in): created by scripts/deploy-chimp-mint.mjs and
#     written here automatically. 9 decimals to match mainnet.
NEXT_PUBLIC_CHIMP_MINT_ADDRESS=
# Treasury token account holding the devnet stand-in supply (script writes it).
CHIMP_TREASURY_TOKEN_ACCOUNT=

# --- $CHIMP devnet mint authority (test stand-in only) --------------
# Generate with: node scripts/gen-mint-authority.mjs
# ONLY controls the devnet test token. The real mainnet mint has no authority.
CHIMP_MINT_AUTHORITY_SECRET=

# --- Astro Corp (company revenue wallet) ------------------------------
# Receives marketplace fees + test-mint payments. Founder-controlled - never
# generated by this app.  Mainnet: 2HJouoXc3KrWULcFqE2t1eQRY2EDjSTWL6KB3bhAQSPU
ASTRO_CORP_WALLET=
