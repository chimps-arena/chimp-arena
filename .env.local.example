# ==========================================================================
# CHIMP Arena - environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never committed.
# ==========================================================================

# --- Supabase -----------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses Row Level Security. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Auth / token signing --------------------------------------------
# Long random string. Signs the session cookie and mission "start" tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# --- Rewards cron ---------------------------------------------------
# Shared secret for POST /api/rewards/freeze (the weekly allocation job).
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=replace-with-a-random-secret

# --- Solana -----------------------------------------------------------
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Custom RPC URL. The public mainnet endpoint rate-limits browsers hard -
# use a free Helius/Triton/QuickNode key. Leave blank to accept the flakiness.
NEXT_PUBLIC_SOLANA_RPC=

# --- Branding -------------------------------------------------------
NEXT_PUBLIC_TOKEN_SYMBOL=CHIMP
NEXT_PUBLIC_APP_NAME=CHIMP Arena
# Absolute origin of the deployment - used to resolve OG / share images.
# Local dev can leave this unset (falls back to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=https://chimp-arena.vercel.app

# --- $CHIMP token -------------------------------------------------
# Live mainnet mint: 1B fixed supply, 9 decimals, mint + freeze authority
# already revoked (nothing to hand off, supply can never change).
NEXT_PUBLIC_CHIMP_MINT_ADDRESS=21ZDgkJ9ULqLoGyHMskAfwVwrx6oixWzxxENu59HHoBV

# --- Astro Corp (company revenue wallet) ------------------------------
# Receives the mint payment + marketplace fees. Founder-controlled - never
# generated by this app. Both must match; NEXT_PUBLIC_ one is read client-side.
ASTRO_CORP_WALLET=2HJouoXc3KrWULcFqE2t1eQRY2EDjSTWL6KB3bhAQSPU
NEXT_PUBLIC_ASTRO_CORP_WALLET=2HJouoXc3KrWULcFqE2t1eQRY2EDjSTWL6KB3bhAQSPU
