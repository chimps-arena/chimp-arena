# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - ignore all real ones, keep the example template
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
dev-server.log

# raw property art - already permanently stored on Arweave once uploaded
# (see scripts/upload-property-art.mjs); too large and no reason to duplicate
# in git. Keep the folder's own README explaining the naming convention.
scripts/property-art/*
!scripts/property-art/README.md
